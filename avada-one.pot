#: plus/inc/theme-options/sections/lightbox.php:189
msgid "Deeplinking"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:190
msgid "Turn on to deeplink images in the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:196
msgid "Loop Lightbox Gallery"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:197
msgid "Turn on to loop the lightbox gallery."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:203
msgid "Autoplay the Lightbox Gallery"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:204
msgid "Turn on to autoplay the lightbox gallery."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:211
msgid "Controls the slideshow speed if autoplay is turned on. ex: 1000 = 1 second."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:222
msgid "Mouse Wheel"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:223
msgid ""
"Controls what the mouse wheel does in the lightbox: move to the next or "
"previous item, or zoom into the image. Pinching on a trackpad always zooms."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:226
msgid "Navigate"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:233
msgid "Close on Background Click"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:234
msgid "Turn on to close the lightbox when clicking next to the image or video."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:240
msgid "Swipe to Close"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:241
msgid ""
"Turn on to close the lightbox on touch devices by swiping the image away: "
"up or down, or sideways with the vertical slide direction."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:247
msgid "Auto-Hide Controls"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:248
msgid ""
"Turn on to fade out the toolbar, arrows and thumbnails after a few seconds "
"without activity. Moving the mouse, pressing a key or tapping the image "
"brings them back."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:260
msgid "Lightbox Color Scheme"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:261
msgid ""
"Controls the lightbox colors. Light, Dark, Auto and Custom Palette take "
"them from a color palette: Color 1 for the background, Color 8 for text and "
"icons, Color 5 for accents. Light and Dark use the palettes set for those "
"color modes; Auto follows the mode the site shows; Custom Palette uses the "
"palette you choose. Custom Colors lets you set the three colors yourself."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:274
msgid "Lightbox Color Palette"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:275
msgid ""
"Select the color palette the lightbox uses. Create an additional palette in "
"the Colors section to style the lightbox on its own."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:285
msgid "Lightbox Background Color"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:286
msgid ""
"Controls the background color of the lightbox. The Background Opacity below "
"applies to it."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:295
msgid "Lightbox Text & Icon Color"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:296
msgid ""
"Controls the color of text and icons in the lightbox. Button backgrounds "
"and hover states are light tints of it."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:305
msgid "Lightbox Accent Color"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:306
msgid ""
"Controls the accent color: the active thumbnail border, the slideshow "
"progress bar, the loading spinner and the video consent button."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:315
msgid "Background Opacity"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:316
msgid "Controls the opacity level for the background behind the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:328
msgid ""
"Set the blur of the page behind the lightbox in pixels, e.g. for frosted "
"glass effects together with a lower background opacity. Set to 0 for no "
"blur."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:339
msgid "Opening Speed"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:340
msgid ""
"Controls how long the lightbox takes to open, in milliseconds. Images zoom "
"from the clicked thumbnail where the browser supports it. Set to 0 to open "
"instantly."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:351
msgid "Transition Effect"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:352
msgid ""
"Controls how the lightbox moves to another item with the arrows, keys, "
"thumbnails or the slideshow. Swiping always slides."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:363
msgid "Slide Direction"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:364
msgid ""
"Controls whether items follow each other horizontally or vertically: the "
"arrows, keys, swipes and the slide transition go that way."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:374
msgid "Slide Transition Speed"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:375
msgid ""
"Controls how long moving to another item takes, in milliseconds, with the "
"arrows, keys, thumbnails or the slideshow. Swiping follows the finger. Set "
"to 0 to switch instantly."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:386
msgid "Lightbox Image Zoom"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:387
msgid ""
"Controls the maximum zoom for images. Clicking or double-tapping the image "
"zooms to it; pinching and the mouse wheel zoom anywhere up to it. Set to 1 "
"to disable zoom."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:398
msgid "Slideshow Progress Bar"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:399
msgid ""
"Controls whether a progress bar shows at the top or the bottom of the "
"lightbox while the slideshow runs."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:410
msgid "Scale Controls on Smaller Screens"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:411
msgid ""
"Turn on to scale the toolbar, arrows and thumbnails down gradually on "
"screens narrower than 1280px, so large sizes set in the sections below "
"still fit on phones. They never get smaller than the default sizes."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:423
msgid "Toolbar Position"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:424
msgid ""
"Controls where the toolbar buttons sit at the top of the lightbox. The "
"image counter takes the other side. In right-to-left languages, left and "
"right swap."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:435
msgid "Image Counter"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:436
msgid ""
"Turn on to display the position of the current item in a gallery, e.g. 2 / "
"8."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:442
msgid "Gallery Start/Stop Button"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:443
msgid "Turn on to display the gallery start and stop button."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:449
msgid "Fullscreen Button"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:450
msgid ""
"Turn on to display the fullscreen button. It only shows in browsers that "
"support fullscreen."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:456
msgid "Download Button"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:457
msgid ""
"Turn on to display a button that downloads the current image or self-hosted "
"video."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:464
msgid "Turn on to display social sharing buttons on lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:470
msgid "Social Sharing Style"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:471
msgid ""
"Controls how the sharing options show: a dropdown list with icons and "
"names, or a grid of icons."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:474
msgid "Dropdown List"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:475
msgid "Icon Grid"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:484
msgid "Toolbar Button Background"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:485
msgid ""
"Turn on to display the toolbar buttons with a background. Turn off to show "
"only the icons."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:491
msgid "Toolbar Icon Size"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:492
msgid ""
"Controls the size of the toolbar icons in pixels. The buttons grow with "
"them."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:503
msgid "Toolbar Icon Spacing"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:504
msgid ""
"Controls the space between the toolbar buttons in pixels. Set to 0 to join "
"the buttons into one bar, with the border radius only on its outer corners."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:515
msgid "Toolbar Button Border Radius"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:516
msgid ""
"Controls the corner radius of the toolbar buttons in pixels. Set to 0 for "
"square buttons; high values make them round."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:534
msgid "Turn on to display arrows in the lightbox"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:541
msgid ""
"Controls whether the arrows sit beside the items, or on the image, so "
"images can use that space and display larger. Videos keep the arrows beside "
"them. Keep the arrow button background on, so the arrows stay visible on "
"bright images."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:554
msgid "Arrow Button Background"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:555
msgid ""
"Turn on to display the previous and next buttons with a background. Turn "
"off to show only the arrows."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:565
msgid ""
"Controls the size of the previous and next arrows in pixels. The buttons "
"grow with them."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:579
msgid "Arrow Button Border Radius"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:580
msgid ""
"Controls the corner radius of the previous and next buttons in pixels. Set "
"to 0 for square buttons; high values make them round."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:600
msgid "Thumbnails Position"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:601
msgid ""
"Controls where the thumbnails of a gallery show. On small screens, "
"thumbnails on the left or right move to the bottom."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:615
msgid "Controls the width and height of the thumbnails in pixels."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:630
msgid "Controls the corner radius of the thumbnails in pixels."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:644
msgid "Title & Caption"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:651
msgid "Turn on to display the image title in the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:658
msgid ""
"These settings control the typography of the lightbox title. The color "
"comes from the lightbox color scheme."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:671
msgid "Turn on to display the image caption in the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:677
msgid "Caption Typography"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:678
msgid ""
"These settings control the typography of the lightbox caption. The color "
"comes from the lightbox color scheme."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:690
msgid "Title & Caption Layout"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:691
msgid "Controls whether the title and caption show outside the image, or over it."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:701
msgid "Title & Caption Overlay Background"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:702
msgid ""
"Controls what keeps overlay titles and captions readable: a fade of the "
"background color, a frosted glass panel, or only a soft glow behind the "
"letters."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:706
msgid "Glass"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:716
msgid "Title & Caption Position"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:717
msgid ""
"Controls whether the title and caption show at the top or the bottom of the "
"image."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:727
msgid "Title & Caption Alignment"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:728
msgid ""
"Controls the alignment of the title and caption, along the edges of the "
"image. In right-to-left languages, left and right swap."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:739
msgid "Show Title & Caption on Hover Only"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:740
msgid ""
"Turn on to show overlay titles and captions only while the mouse is over "
"the image. On touch screens, they show when the image is tapped. Without "
"this, a tap on the image hides them."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:755
msgid "Slideshow Video Dimensions"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:756
msgid "Controls the width and height for videos inside the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:766
msgid "Autoplay Videos"
msgstr ""

#: plus/inc/theme-options/sections/lightbox.php:767
msgid "Turn on to start videos as soon as they show in the lightbox."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:38
msgid ""
"Set your site to Maintenance Mode to take it offline temporarily (status "
"code 503), or to Coming Soon mode (status code 200), taking it offline "
"until it is ready to be launched."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:48
msgid "URL Redirect"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:49
msgid ""
"If set, this option will redirect users without access to the URL given. "
"Enter with protocol (e.g. https://)."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:57
msgid "Page Template"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:58
msgid "Select an Avada Library template for the Maintenance or Coming Soon page."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:68
msgid "User Roles For Access"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:69
msgid ""
"Select the user roles that should be able to access the site when "
"maintenance mode is turned on. <strong>NOTE:</strong> Administrators will "
"always have access."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:79
msgid ""
"Exclude parts of your site like feed, pages, or archives from Maintenance "
"or Coming Soon mode. Add one slug or URL per line."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:87
msgid "Page Title HTML Tag"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:88
msgid ""
"This will also be used in the default page template. Leave empty for "
"default title."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:97
msgid "Robots Meta Tag"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:98
msgid ""
"Decide whether the Maintenance or Coming Soon page should get indexed by "
"search engines."
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:101
msgid "Index/Follow"
msgstr ""

#: plus/inc/theme-options/sections/maintenance.php:102
msgid "Noindex/Nofollow"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:9
msgid "Experiments & Links"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:69
msgid ""
"Record behavioural visitor data — page views, scrolling, time on page and "
"visit sessions. Turning this off also disables A/B testing and empties "
"contact activity timelines; operational records like cart snapshots and "
"link click counts keep working through their own features. How far visitors "
"may be identified is set by the Visitor Tracking Mode under Privacy & "
"Consent → Data Collection."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:74
msgid "A/B Testing"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:75
msgid ""
"Assign visitors to experiment variations and record impressions. Requires "
"Visitor Analytics."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:84
msgid ""
"Mask IP addresses before saving visit data. Note this anonymizes the stored "
"data only — cookies set by tracking features still require consent where "
"applicable."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:92
msgid "Geolocation"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:101
msgid "Download Geolocation Data"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:102
msgid ""
"Download or delete the geolocation database. These are the IP => "
"Continent/Country matches. A good rule of thumb is to re-download the "
"geolocation data every 1-3 years."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:111
msgid "Link Cloak Subpath"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:112
msgid "URL subpath used for affiliate link cloaking."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:123
msgid "Enable creating and sending email campaigns to your contact lists."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:134
msgid ""
"Master switch for the custom email designs feature and all outbound email. "
"When off, no emails are sent — campaigns, price alerts, abandoned cart "
"recovery, review reminders, and more. This does not affect the mailer "
"settings below, which only configure how emails are sent once this is "
"re-enabled."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:139
msgid "From Name"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:140
msgid ""
"The sender name shown on all outbound emails — campaigns, alerts, "
"reminders, and more."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:148
msgid "From Email"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:149
msgid ""
"Required for all emails to send. The sender address used for all outbound "
"emails — campaigns, alerts, reminders, and more."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:157
msgid "Reply To Name"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:158
msgid ""
"The name shown as reply-to on all outbound emails — campaigns, price "
"alerts, abandoned cart recovery, review reminders, and more."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:167
msgid ""
"The email address used as reply-to on all outbound emails — campaigns, "
"price alerts, abandoned cart recovery, review reminders, and more."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:175
msgid "Email Sender"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:176
msgid ""
"Choose how campaign and (optionally) transactional emails are sent. "
"\"None\" falls back to your site's normal wp_mail() delivery."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:179
msgid "Postmark"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:180
msgid "Amazon SES"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:190
#. translators: %s is the webhook endpoint URL to subscribe via SNS.
msgid ""
"A webhook is used to keep email statuses (delivered, opened, clicked, "
"bounced, complained) up to date in the Email Logs. In SNS, add an HTTPS "
"subscription to this URL on the topic your Configuration Set publishes "
"events to: %s"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:200
msgid "SES Region"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:201
msgid "Select the region matching your Amazon SES account."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:211
msgid "SES Configuration Set"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:212
msgid ""
"Optional. Enter the name of your SES Configuration Set to enable event "
"tracking (opens, clicks, bounces etc). Leave empty to send without a "
"configuration set."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:221
msgid "SNS Topic ARN"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:222
msgid ""
"Required for the webhook. The ARN of the SNS topic your Configuration Set "
"publishes events to, for example "
"arn:aws:sns:us-east-1:123456789012:ses-events. SNS messages from any other "
"topic are rejected, and all SNS messages are rejected until this is set."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:232
msgid "SES Access Key"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:233
msgid "The access key for your Amazon SES account."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:243
msgid "SES Secret Key"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:244
msgid "The secret key for your Amazon SES account."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:255
msgid "Postmark Server Token"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:256
msgid "The server API token for your Postmark account."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:266
msgid "Postmark Transactional Message Stream"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:267
msgid ""
"The Postmark message stream ID used for transactional emails. Default: "
"outbound."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:276
msgid "Postmark Broadcast Message Stream"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:277
msgid ""
"The Postmark message stream ID used for campaign/broadcast emails. Default: "
"broadcast."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:287
#. translators: %s is the webhook endpoint URL to paste into Postmark.
msgid ""
"A webhook is used to keep email statuses (delivered, opened, clicked, "
"bounced, spam) up to date in the Email Logs. Postmark webhooks are set per "
"Message Stream, so add this URL under Webhooks on both the transactional "
"and broadcast streams above, with the webhook username and password below "
"as its Basic Auth credentials: %s"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:298
msgid "Postmark Webhook Username"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:299
msgid ""
"Required for the webhook. The Basic Auth username Postmark must send when "
"calling it. Webhook events are rejected until both username and password "
"are set."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:309
msgid "Postmark Webhook Password"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:310
msgid ""
"Required for the webhook. The Basic Auth password Postmark must send when "
"calling it. Webhook events are rejected until both username and password "
"are set."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:320
msgid "Send Rate (Per Minute)"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:321
msgid ""
"Set the send rate. Note, this needs to be within the acceptable rate on "
"your provider account."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:330
msgid "Use Provider For WP Mail"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:331
msgid "Route all WordPress emails through the configured mailer provider."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:341
msgid ""
"Send the Birthday Email to the active contacts on your lists on their "
"birthday, at 9am in the time zone set under Settings → General. Contacts "
"are signed up for it when they first get a birthday, and can unsubscribe "
"from it on its own."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:349
msgid "Manage Subscriptions Page"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:350
msgid "Page where users can manage their subscription preferences."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:360
msgid "Unsubscribe Page"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:361
msgid ""
"Page where users land to unsubscribe. Falls back to Manage Subscriptions "
"page if empty."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:371
msgid "Activation Page"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:372
msgid ""
"Page for double opt-in / account activation. Falls back to Manage "
"Subscriptions page if empty."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:384
msgid "Recreate System Email Designs"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:385
msgid ""
"Deletes and recreates the built-in system emails (Subscription "
"Verification, Review Reminder, Price Drop Alert, Back in Stock Alert, "
"Abandoned Cart Recovery, Wishlist Reminder, Birthday Email) with their "
"original designs. Any customisations made to these emails will be lost."
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:388
msgid "Recreate Designs"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:389
msgid ""
"This will permanently delete the current system emails and recreate them "
"from their default designs. Any customisations will be lost. Continue?"
msgstr ""

#: plus/inc/theme-options/sections/marketing.php:390
