msgstr "Selecciona el color de fondo del botón de cargar más."

msgid "Select load more button text color."
msgstr "Selecciona el color del texto del botón de cargar más."

msgid "Select main steps navigation style."
msgstr "Selecciona el estilo principal de la navegación de pasos."

