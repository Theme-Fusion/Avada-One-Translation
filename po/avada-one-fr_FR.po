msgstr "Sélectionnez ou saisissez l'étiquette de produit à vérifier pour afficher l'élément."

msgid "Select or search for form"
msgstr "Sélectionnez ou recherchez un formulaire"

msgid "Select or search for post"
msgstr "Sélectionnez ou recherchez un article"

msgid "Select or search for product"
msgstr "Sélectionnez ou recherchez un produit"

msgid "Select or search for products"
msgstr "Sélectionnez ou recherchez des produits"

msgid "Select pattern."
msgstr "Sélectionnez le motif."

