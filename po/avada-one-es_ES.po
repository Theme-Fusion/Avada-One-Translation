msgid "A list of all selectors is found %s here %s."
msgstr "Encontrarás una lista de todos los selectores %s aquí %s."

msgid "A name to identify this palette, e.g. \"Dark Theme\"."
msgstr "Un nombre para identificar esta paleta, p. ej., \"Tema oscuro\"."

