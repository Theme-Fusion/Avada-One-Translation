msgstr "Sélectionnez la couleur des icônes de note vides."

msgid "Select the color of the filled icons."
msgstr "Sélectionnez la couleur des icônes pleines."

msgid "Select the color of the filled rating icons."
msgstr "Sélectionnez la couleur des icônes de note pleines."

msgid "Select the color of the link on hover."
msgstr "Sélectionnez la couleur du lien au survol."

msgid "Select the color of the rating text."
msgstr "Sélectionnez la couleur du texte de la note."

msgid "Select the color of the separator."
msgstr "Sélectionnez la couleur du séparateur."

