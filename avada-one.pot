msgstr ""

#: builder/elements/tabs/Params.php:732
msgid ""
"Controls the color of the tab descriptions. Leave empty to use the active "
"tab title color."
msgstr ""

#: builder/elements/tabs/Params.php:740
msgid "Content Height"
msgstr ""

#: builder/elements/tabs/Params.php:741
msgid ""
"Set a fixed height for the tab content area. When the content exceeds this "
"height, a scrollbar will appear. Leave empty to disable. Enter value with "
"unit, ex: 400px."
msgstr ""

