msgstr "Contrôle la taille de la bordure du cercle de contenu. En pixels."

msgid "Contols the border size of icon circle. In pixels."
msgstr "Contrôle la taille de la bordure du cercle d'icône. En pixels."

msgid "Contols the icon border size. In pixels."
msgstr "Contrôle la taille de la bordure de l'icône. En pixels."

msgid "Contols the icon hover/active border size. In pixels."
msgstr "Contrôle la taille de la bordure de l'icône au survol/actif. En pixels."

msgid "Contols the icon size. In pixels."
msgstr "Contrôle la taille de l'icône. En pixels."

msgid "Contols the spacing between circle and content. In pixels."
msgstr "Contrôle l'espacement entre le cercle et le contenu. En pixels."

msgid "Contract Popup"
msgstr "Réduire la popup"

msgid "Contrast"
msgstr "Contraste"

msgid "Contrast Ratio"
msgstr "Rapport de contraste"

msgid "Contrast Ratio (Colors 1 & 5)"
msgstr "Rapport de contraste (couleurs 1 et 5)"

